# Copy this file to .env and fill in a real value:
#
#   cp .env.example .env
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
#
# .env is listed in .gitignore and must never be committed.

DJANGO_SECRET_KEY=replace-me-with-a-generated-secret-key
DJANGO_DEBUG=True

# Hosts Django will answer for, comma-separated. Add the VM's IP when you
# browse the project from the host machine, e.g.:
#   DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,192.168.56.10
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Where the sqlite file lives. Leave unset to keep it next to manage.py.
# Set it to a path on the guest filesystem when the repository itself sits on
# a VirtualBox shared folder, which does not support the locking sqlite needs:
#   DJANGO_DB_PATH=/home/student/d08-db.sqlite3
